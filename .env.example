# Docker Compose development defaults. Copy this file to .env before starting.
MYSQL_DATABASE=campusdeal
MYSQL_USER=campusdeal
MYSQL_PASSWORD=campusdeal_dev
MYSQL_ROOT_PASSWORD=campusdeal_root_dev

# Values below are also suitable for running Maven directly on the host.
CAMPUSDEAL_DB_URL=jdbc:mysql://localhost:3306/campusdeal?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true
CAMPUSDEAL_DB_USERNAME=campusdeal
CAMPUSDEAL_DB_PASSWORD=campusdeal_dev
CAMPUSDEAL_REDIS_HOST=localhost
CAMPUSDEAL_REDIS_PORT=6379
CAMPUSDEAL_REDIS_PASSWORD=campusdeal_dev
CAMPUSDEAL_FLYWAY_ENABLED=true

# Optional integrations are disabled for the reproducible base stack.
CAMPUSDEAL_AGENT_ENABLED=false
CAMPUSDEAL_DEEPSEEK_API_KEY=
CAMPUSDEAL_KAFKA_ENABLED=false
CAMPUSDEAL_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CAMPUSDEAL_CANAL_ENABLED=false
CAMPUSDEAL_PGVECTOR_ENABLED=false
CAMPUSDEAL_PGVECTOR_URL=jdbc:postgresql://localhost:5432/campusdeal_rag
CAMPUSDEAL_PGVECTOR_USERNAME=campusdeal
CAMPUSDEAL_PGVECTOR_PASSWORD=campusdeal_dev
CAMPUSDEAL_NEO4J_ENABLED=false
CAMPUSDEAL_NEO4J_URI=bolt://localhost:7687
CAMPUSDEAL_NEO4J_USER=neo4j
CAMPUSDEAL_NEO4J_PASSWORD=campusdeal_dev
